{"type":"Microchip CLB Synthesizer Design","version":"2.0","name":"3xPWMdesign","projectId":"826a0f43-7c07-4410-9d87-c68bbc81cc71","creationDate":"2023-09-07T17:19:35.561Z","backendversion":"https://logic.microchip.com/","device":"PIC16F13145","documentModels":[{"type":1,"id":"4f652c6f-dbe3-4a4f-80be-20ac45f0b55c","name":"incr3","text":"module incr3(in2,in1,in0,out2,out1,out0);\n    input in2, in1, in0;\n    output out2, out1, out0;\n    wire [2:0] inbus;\n    wire [2:0] outbus;\n    assign inbus = {in2, in1, in0};\n    assign outbus = inbus + 1;\n    assign out2 = outbus[2];\n    assign out1 = outbus[1];\n    assign out0 = outbus[0];\nendmodule"},{"type":1,"id":"1cb22271-78a2-4463-ae36-4fbd947e6211","name":"value_to_PWM","text":"module value_to_PWM\n  (\n   level2, level1, level0,\n   c2, c1, c0,\n   anode           // LED display\n   );\n   input level2, level1, level0;\n   input c2, c1, c0; //3 bits from a binary counter\n   output anode;\n   wire [2:0] level;\n   wire [2:0] cnt;\n   assign level = {level2, level1, level0};\n   assign cnt = {c2, c1, c0};\n  assign anode = (cnt < level);\n\t\t\t\t\t\t\t\t\t   \nendmodule"},{"type":0,"id":"da0115c0-4358-4033-a768-60d06f622fb3","name":"main","data":{"class":"GraphLinksModel","linkKeyProperty":"key","linkFromPortIdProperty":"fromPort","linkToPortIdProperty":"toPort","nodeDataArray":[{"category":"sheet","loc":"-410 -280","key":1,"angle":0,"flipX":false,"refdes":"","name":"incr3","inputs":[{"portId":"in2","label":"in2","settings":{}},{"portId":"in1","label":"in1","settings":{}},{"portId":"in0","label":"in0","settings":{}}],"outputs":[{"portId":"out2","label":"out2","settings":{}},{"portId":"out1","label":"out1","settings":{}},{"portId":"out0","label":"out0","settings":{}}],"globalinputs":[],"globaloutputs":[]},{"category":"dff","loc":"-40 -310","key":2,"angle":0,"flipX":false},{"category":"dff","loc":"-40 -210","key":3,"angle":0,"flipX":false},{"category":"dff","loc":"-40 -120","key":4,"angle":0,"flipX":false},{"catego